# OAuth 2.0 authorization code flow with PKCE (RFC 7636), after the Auth0 diagram. Browser redirects are
# asynchronous, token exchange and API call synchronous with a reply.
diagram sequence "Anmeldung mit OAuth 2.0" subtitle="Authorization Code Flow mit PKCE (RFC 7636)" locale=de
actor nutzer "Nutzer"
participant app "App" stereotype="public client"
participant idp "Autorisierungsserver" external
participant api "Ressourcen-API"
msg nutzer -> app "Login-Link klicken"
msg app -> app "code_verifier erzeugen, code_challenge = SHA256(code_verifier)"
msg app ~> idp "GET /authorize (code_challenge, method=S256)"
msg idp ~> nutzer "Weiterleitung zu Login und Zustimmung"
msg nutzer ~> idp "Anmelden und zustimmen"
msg idp ~> app "Redirect mit Authorization Code"
msg app -> idp "POST /oauth/token (code, code_verifier)"
msg idp -> idp "SHA256(code_verifier) mit code_challenge vergleichen"
alt "Prüfung erfolgreich"
  msg idp --> app "ID-Token und Access-Token"
  msg app -> api "GET /daten (Bearer Access-Token)"
  msg api --> app "200 Daten"
  msg app --> nutzer "Startseite"
  else
    msg idp --> app "400 invalid_grant"
    msg app --> nutzer "Fehlermeldung"
note "Der code_verifier verlässt die App nie: ein abgefangener Code ist ohne ihn wertlos." over=app,idp
