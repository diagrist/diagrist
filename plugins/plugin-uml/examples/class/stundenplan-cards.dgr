# The timetable in the card look: the same n-ary association as stundenplan.dgr, all of it in the toned
# package Lehrbetrieb. The note is a card with a folded corner; diamond and lines stay notation.
diagram class "Stundenplan" subtitle="N-äre Assoziation im Kartenstil" look=cards locale=de
package lehre "Lehrbetrieb" tone=indigo
class dozent "Dozent" in lehre tone=blue
  "- name : String"
class kurs "Kurs" in lehre
  "- titel : String"
class raum "Raum" in lehre
  "- nummer : String"
  "- plaetze : int"
class termin "Termin" in lehre
  "- beginn : DateTime"
  "- dauer : Minuten"
class einheit "Unterrichtseinheit" in lehre tone=teal
  "- thema : String"
  "- anwesend : int"
assoc unterricht "Unterricht" class=einheit in lehre
rel unterricht -- dozent card=1
rel unterricht -- kurs card=0..*
rel unterricht -- raum card=0..1
rel unterricht -- termin card=*
note "Genau ein Dozent je Stunde" on dozent
