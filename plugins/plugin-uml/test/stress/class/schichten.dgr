# Pressure: controllers, services and repositories in three layers, each service using two or three repositories.
diagram class "Bestellservice" subtitle="Controller, Dienste und Repositories" locale=de
class bestellctl "BestellController" stereotype="controller"
  "+ bestelle(dto : BestellDto) : Antwort"
class kundectl "KundenController" stereotype="controller"
  "+ registriere(dto : KundeDto) : Antwort"
class bestellsvc "BestellService" stereotype="service"
  "+ lege(b : Bestellung) : void"
class kundesvc "KundenService" stereotype="service"
  "+ lege(k : Kunde) : void"
class preissvc "PreisService" stereotype="service"
  "+ preis(a : Artikel) : Geld"
interface bestellrepo "BestellRepository"
  "+ speichere(b : Bestellung) : void"
interface kunderepo "KundenRepository"
  "+ finde(id : Long) : Kunde"
interface artikelrepo "ArtikelRepository"
  "+ finde(nr : String) : Artikel"
interface rabattrepo "RabattRepository"
  "+ gueltige() : Liste"
rel bestellctl --> bestellsvc "nutzt"
rel bestellctl --> kundesvc "nutzt"
rel kundectl --> kundesvc "nutzt"
rel bestellsvc --> preissvc "nutzt"
rel bestellsvc --> bestellrepo "nutzt"
rel bestellsvc --> kunderepo "nutzt"
rel kundesvc --> kunderepo "nutzt"
rel preissvc --> artikelrepo "nutzt"
rel preissvc --> rabattrepo "nutzt"
rel bestellsvc --> artikelrepo "nutzt"
