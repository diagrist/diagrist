{
  // Shared compiler options. TypeScript 7 already defaults to strict, esModuleInterop and
  // noUncheckedSideEffectImports; this file states what differs or is pinned on purpose.
  "compilerOptions": {
    // Runs on Node 22+, current browsers and edge runtimes; all support ES2023.
    "target": "es2023",
    "lib": ["es2023"],
    // Real Node ESM resolution: imports carry the .js extension they are resolved with at runtime.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    // Packages resolve each other through their source inside the monorepo (see exports in package.json).
    "customConditions": ["@diagrist/source"],

    // Stricter than strict
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,

    // Exported declarations need explicit types: the public API is readable in the code, and declaration
    // files are emitted without a type check (fast builds with tsdown). Hand-written APIs only: tests and
    // plugin tables turn it off, because their types are derived from the tables (ADR 0004).
    "isolatedDeclarations": true,
    // No enum, namespace or parameter properties: types can be erased by any tool without rewriting code.
    "erasableSyntaxOnly": true,
    // No global types by default. A package that needs Node says so, which keeps Node APIs out of the kernel.
    "types": [],

    "verbatimModuleSyntax": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "skipLibCheck": true
  }
}
