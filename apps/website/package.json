{
  "name": "@diagrist/website",
  "version": "0.0.0",
  "private": true,
  "description": "The website at diagrist.com: landing page and docs, built with Astro and Starlight from the files the tables generate.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --workspace-root build && astro dev",
    "build": "pnpm --workspace-root build && astro sync && tsc -p tsconfig.json --noEmit && astro build",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.4",
    "@astrojs/starlight": "^0.42.7",
    "@diagrist/core": "workspace:*",
    "@diagrist/lang": "workspace:*",
    "@diagrist/plugin-architecture": "workspace:*",
    "@diagrist/plugin-code": "workspace:*",
    "@diagrist/plugin-concept": "workspace:*",
    "@diagrist/plugin-uml": "workspace:*",
    "astro": "^7.4.2",
    "starlight-llms-txt": "^0.12.0",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4"
  }
}
