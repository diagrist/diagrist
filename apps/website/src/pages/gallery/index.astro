---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import GalleryDetail from '../../components/GalleryDetail.astro';
import { examples, groups, kinds } from '../../lib/gallery.js';

/**
 * The gallery: every example of the repository as a picture, filtered by kind or a search. A click opens the
 * example in a window with its source, the way to the live editor and the file on GitHub, and the address names it.
 */
const all = examples();
const sections = groups(all);
const first = sections[0];
---

<StarlightPage
  frontmatter={{
    title: 'Gallery',
    description: `Every example of the Diagrist repository, ${all.length} diagrams of UML, C4, code, matrices and concept pictures, each ready to change in the live editor.`,
    template: 'splash',
    editUrl: false,
  }}
>
  <p>
    Every example of the repository, drawn when the site was built. Open one to read its source and change it in
    the <a href="https://live.diagrist.com/">live editor</a>, or start there from an empty page. Most examples are
    written in German, with <code>locale=de</code> in the header.
  </p>

  <div class="not-content gallery-tools">
    <input id="gallery-search" type="search" placeholder="Search by title, kind or file" aria-label="Search the examples" />
    <div class="gallery-chips" role="group" aria-label="Kind">
      <button type="button" data-kind="" aria-pressed="true">all <span>{all.length}</span></button>
      {
        kinds(all).map(({ kind, count }) => (
          <button type="button" data-kind={kind} aria-pressed="false">
            {kind} <span>{count}</span>
          </button>
        ))
      }
    </div>
    <p id="gallery-count" class="gallery-count" aria-live="polite"></p>
  </div>

  <p id="gallery-empty" class="not-content gallery-empty" hidden>No example matches. Try another word or kind.</p>

  {
    sections.map((group) => (
      <section class="gallery-group">
        <h2 id={`${group.plugin.toLowerCase()}-${group.name}`}>
          {group.name} <span class="gallery-plugin">{group.plugin}</span>
        </h2>
        <div class="not-content gallery-grid">
          {group.examples.map((example, index) => (
            <a
              class="gallery-card"
              href={`#${example.slug}`}
              data-slug={example.slug}
              data-kind={example.kind}
              data-title={example.title}
              data-file={example.file}
              data-look={example.look}
              data-github={example.github}
              data-search={[example.title, example.kind, example.file, example.group, example.look ?? '']
                .join(' ')
                .toLowerCase()}
            >
              <span class="gallery-thumb">
                <img
                  src={`/gallery/${example.slug}.svg`}
                  alt=""
                  loading={group === first && index < 4 ? 'eager' : 'lazy'}
                  decoding="async"
                />
              </span>
              <span class="gallery-title">{example.title}</span>
              <span class="gallery-tags">
                <span>{example.kind}</span>
                {example.look && <span>{example.look}</span>}
              </span>
            </a>
          ))}
        </div>
      </section>
    ))
  }

  <GalleryDetail />
</StarlightPage>

<script>
  import '../../scripts/gallery-filter.js';
  import '../../scripts/gallery-detail.js';
</script>

<style>
  .gallery-tools {
    position: sticky;
    top: var(--sl-nav-height);
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-block: 1.5rem 0;
    padding-block: 0.75rem;
    background: var(--sl-color-bg);
    border-bottom: 1px solid var(--sl-color-hairline);
  }
  .gallery-tools input {
    flex: 0 1 18rem;
    padding: 0.4rem 0.75rem;
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 0.375rem;
    background: var(--sl-color-bg);
    color: var(--sl-color-white);
    font: inherit;
  }
  .gallery-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }
  .gallery-chips button {
    padding: 0.2rem 0.65rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    background: none;
    color: var(--sl-color-gray-2);
    font: inherit;
    font-size: var(--sl-text-sm);
    cursor: pointer;
  }
  .gallery-chips button span {
    color: var(--sl-color-gray-3);
  }
  .gallery-chips button[aria-pressed='true'] {
    border-color: var(--sl-color-accent);
    background: var(--sl-color-accent-low);
    color: var(--sl-color-white);
  }
  .gallery-count {
    margin: 0 0 0 auto;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }
  @media (max-width: 50rem) {
    .gallery-chips {
      flex-wrap: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .gallery-chips button {
      flex: none;
    }
  }
  .gallery-empty {
    margin-block: 3rem;
    text-align: center;
    color: var(--sl-color-gray-3);
  }
  .gallery-group h2 {
    scroll-margin-top: calc(var(--sl-nav-height) + 5rem);
  }
  .gallery-plugin {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
    font-weight: 400;
  }
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
    gap: 1rem;
    margin-block: 1rem 2.5rem;
  }
  .gallery-card {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    color: var(--sl-color-white);
    text-decoration: none;
  }
  .gallery-card[hidden] {
    display: none;
  }
  .gallery-thumb {
    display: block;
    padding: 0.5rem;
    background: #fff;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .gallery-thumb img {
    display: block;
    width: 100%;
    height: 11rem;
    object-fit: contain;
  }
  .gallery-card:hover .gallery-thumb,
  .gallery-card:focus-visible .gallery-thumb {
    border-color: var(--sl-color-accent);
    box-shadow: 0 0 0 1px var(--sl-color-accent);
  }
  .gallery-card:focus-visible {
    outline: none;
  }
  .gallery-title {
    font-weight: 600;
    line-height: 1.3;
  }
  .gallery-tags {
    display: flex;
    gap: 0.375rem;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
  .gallery-tags span {
    padding: 0 0.4rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.25rem;
    font-family: var(--__sl-font-mono);
  }
</style>
