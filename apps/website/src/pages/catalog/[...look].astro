---
import { catalog, LOOKS } from '../../lib/catalog.js';

/**
 * The catalog: every element, shape, icon, tone, arrow, flow, frame and card form of the C4 kinds as a tile, one page
 * per look. A working overview with its own layout, not a page of the docs; everything on it comes from the tables.
 */
export function getStaticPaths() {
  return LOOKS.map((look, i) => ({ params: { look: i === 0 ? undefined : look }, props: { look } }));
}

const { look } = Astro.props as { look: string };
const sections = catalog(look);
const count = sections.reduce((sum, s) => sum + s.tiles.length, 0);
const hrefOf = (l: string) => (l === LOOKS[0] ? '/catalog/' : `/catalog/${l}/`);
const inline = (text: string) =>
  text
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/`([^`]+)`/g, '<code>$1</code>');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Catalog · {look} · Diagrist</title>
    <meta name="description" content={`Every element, shape, icon, tone and arrow of the C4 kinds in look=${look}.`} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="bar">
      <div class="bar-row">
        <a class="brand" href="/">Diagrist</a>
        <span class="crumb">Catalog</span>
        <nav class="looks" aria-label="Look">
          {LOOKS.map((l) => <a href={hrefOf(l)} aria-current={l === look ? 'page' : undefined}>{l}</a>)}
        </nav>
        <span class="links"><a href="/gallery/">Gallery</a><a href="/docs/language/">Language</a></span>
      </div>
      <nav class="jump" aria-label="Sections">
        {sections.map((s) => <a href={`#${s.id}`}>{s.title} <span>{s.tiles.length}</span></a>)}
      </nav>
    </header>
    <main>
      <p class="lead">
        {count} tiles of the C4 kinds in <code>look={look}</code>, drawn from their tables when the site was built. Each tile
        shows the line a file writes; a click shows it larger with its whole source, and the editor link opens it to try.
      </p>
      {
        sections.map((s) => (
          <section id={s.id}>
            <h2>{s.title}</h2>
            <p class="doc" set:html={inline(s.doc)} />
            <div class:list={['tiles', { wide: s.wide }]}>
              {s.tiles.map((t) => (
                <article class="tile">
                  <button class="open" type="button" data-source={t.source} data-editor={t.editor} data-section={s.title}>
                    <span class="picture" set:html={t.svg} />
                    <span class="name">{t.name}</span>
                    <code class="line">{t.line}</code>
                  </button>
                  <a class="editor" href={t.editor} target="_blank" rel="noopener">
                    Editor ↗
                  </a>
                </article>
              ))}
            </div>
          </section>
        ))
      }
    </main>
    <dialog id="zoom" aria-labelledby="zoom-name">
      <div class="zoom-head">
        <div>
          <span class="zoom-section" id="zoom-section"></span>
          <strong id="zoom-name"></strong>
        </div>
        <span class="zoom-actions">
          <span class="zoom-hint">← → to browse</span>
          <a id="zoom-editor" href="/" target="_blank" rel="noopener">Open in the live editor ↗</a>
          <button type="button" id="zoom-close" aria-label="Close" autofocus>✕</button>
        </span>
      </div>
      <div class="zoom-picture" id="zoom-picture"></div>
      <code class="zoom-line" id="zoom-line"></code>
      <pre id="zoom-source"></pre>
    </dialog>
  </body>
</html>

<script>
  /**
   * A click on a tile shows it larger in a dialog with its whole source and the editor link; the arrow keys move to
   * the neighbouring tiles of the same section, Escape or a click beside the dialog closes it.
   */
  const dialog = document.querySelector<HTMLDialogElement>('#zoom');
  const editor = document.querySelector<HTMLAnchorElement>('#zoom-editor');
  const tiles = [...document.querySelectorAll<HTMLButtonElement>('button.open')];
  let shown = -1;

  /** How much larger than drawn a tile may grow, so a single box does not fill the screen. */
  const ZOOM = 2.5;

  function fill(id: string, text: string): void {
    const target = document.querySelector<HTMLElement>(`#${id}`);
    if (target !== null) target.textContent = text;
  }

  function show(index: number): void {
    const tile = tiles[index];
    const picture = document.querySelector<HTMLElement>('#zoom-picture');
    if (dialog === null || editor === null || picture === null || tile === undefined) return;
    shown = index;
    fill('zoom-section', tile.dataset.section ?? '');
    fill('zoom-name', tile.querySelector('.name')?.textContent ?? '');
    fill('zoom-line', tile.querySelector('.line')?.textContent ?? '');
    fill('zoom-source', tile.dataset.source ?? '');
    picture.innerHTML = tile.querySelector('.picture')?.innerHTML ?? '';
    const svg = picture.querySelector('svg');
    if (svg !== null) svg.style.maxWidth = `${Number(svg.getAttribute('width')) * ZOOM}px`;
    editor.href = tile.dataset.editor ?? '/';
    if (!dialog.open) dialog.showModal();
  }

  tiles.forEach((tile, i) => {
    tile.addEventListener('click', () => show(i));
  });
  document.querySelector('#zoom-close')?.addEventListener('click', () => dialog?.close());
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });
  dialog?.addEventListener('keydown', (event) => {
    const step = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0;
    const next = tiles[shown + step];
    if (step === 0 || next === undefined || next.dataset.section !== tiles[shown]?.dataset.section) return;
    event.preventDefault();
    show(shown + step);
  });
</script>

<style is:global>
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    font: 14px/1.45 system-ui, -apple-system, 'Segoe UI', sans-serif;
    color: #1f2328;
    background: #f6f7f9;
  }
  code {
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    font-size: 12px;
  }
  .bar {
    position: sticky;
    top: 0;
    z-index: 1;
    background: #fff;
    border-bottom: 1px solid #d0d7de;
  }
  .bar-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.5rem 1.25rem;
  }
  .brand {
    font-weight: 700;
    color: inherit;
    text-decoration: none;
  }
  .crumb {
    color: #59636e;
  }
  .looks {
    display: flex;
    border: 1px solid #d0d7de;
    border-radius: 6px;
    overflow: hidden;
  }
  .looks a {
    padding: 0.2rem 0.7rem;
    color: #1f2328;
    text-decoration: none;
    border-left: 1px solid #d0d7de;
  }
  .looks a:first-child {
    border-left: 0;
  }
  .looks a[aria-current='page'] {
    background: #0969da;
    color: #fff;
  }
  .links {
    margin-left: auto;
    display: flex;
    gap: 1rem;
  }
  a {
    color: #0969da;
  }
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    padding: 0.3rem 1.25rem 0.5rem;
    font-size: 13px;
  }
  .jump a {
    text-decoration: none;
  }
  .jump span {
    color: #59636e;
  }
  main {
    padding: 0.5rem 1.25rem 3rem;
  }
  .lead,
  .doc {
    color: #59636e;
    max-width: 60rem;
  }
  section {
    scroll-margin-top: 6rem;
  }
  h2 {
    margin: 1.75rem 0 0.25rem;
    font-size: 18px;
  }
  .tiles {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(10.5rem, 1fr));
    gap: 0.6rem;
  }
  .tiles.wide {
    grid-template-columns: repeat(auto-fill, minmax(20rem, 1fr));
  }
  .tile {
    position: relative;
    background: #fff;
    border: 1px solid #d0d7de;
    border-radius: 6px;
  }
  .tile:hover,
  .tile:focus-within {
    border-color: #0969da;
    outline: 1px solid #0969da;
  }
  .open {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    width: 100%;
    padding: 0.4rem 0.4rem 1.6rem;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: start;
    cursor: zoom-in;
  }
  .editor {
    position: absolute;
    right: 0.5rem;
    bottom: 0.35rem;
    font-size: 12px;
    text-decoration: none;
  }
  .editor:hover {
    text-decoration: underline;
  }
  dialog {
    width: min(70rem, 94vw);
    max-height: 92vh;
    padding: 0;
    border: 1px solid #d0d7de;
    border-radius: 8px;
    box-shadow: 0 12px 40px rgb(0 0 0 / 0.25);
  }
  dialog::backdrop {
    background: rgb(15 20 25 / 0.55);
  }
  .zoom-head {
    position: sticky;
    top: 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 0.6rem 1rem;
    border-bottom: 1px solid #d0d7de;
    background: #fff;
  }
  .zoom-section {
    margin-right: 0.5rem;
    color: #59636e;
  }
  .zoom-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .zoom-hint {
    color: #59636e;
    font-size: 12px;
  }
  #zoom-close {
    padding: 0.15rem 0.5rem;
    border: 1px solid #d0d7de;
    border-radius: 6px;
    background: #f6f7f9;
    cursor: pointer;
  }
  .zoom-picture {
    display: flex;
    justify-content: center;
    padding: 1rem;
    background: #f6f7f9;
  }
  .zoom-picture svg {
    width: 100%;
    height: auto;
    max-height: 55vh;
  }
  .zoom-line {
    display: block;
    padding: 0.6rem 1rem 0;
    color: #59636e;
  }
  dialog pre {
    margin: 0.5rem 1rem 1rem;
    padding: 0.75rem;
    overflow: auto;
    border-radius: 6px;
    background: #f6f7f9;
    font-size: 12px;
  }
  .picture {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 7rem;
  }
  .wide .picture {
    height: 8rem;
  }
  .picture svg {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
  }
  .name {
    font-weight: 600;
  }
  .line {
    color: #59636e;
    overflow-wrap: anywhere;
  }
</style>
