{
  "name": "@diagrist/core",
  "version": "0.0.0",
  "description": "The Diagrist kernel: plugin registry, compile, scene, text metrics and SVG.",
  "keywords": [
    "diagrist",
    "diagrams-as-code",
    "diagram",
    "svg",
    "renderer",
    "kernel"
  ],
  "homepage": "https://github.com/diagrist/diagrist/tree/main/packages/core#readme",
  "bugs": "https://github.com/diagrist/diagrist/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diagrist/diagrist.git",
    "directory": "packages/core"
  },
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@diagrist/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "fonts",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22.11"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "@diagrist/lang": "workspace:*"
  },
  "devDependencies": {
    "@diagrist/testkit": "workspace:*"
  }
}
