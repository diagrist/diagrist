{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": ".tsbuild",
    "emitDeclarationOnly": true,
    // The `adr` statement is typed by `Infer` from its table (ADR 0004); writing it out again would repeat it.
    "isolatedDeclarations": false
  },
  "include": ["src"],
  "references": [{ "path": "../lang" }, { "path": "../core" }]
}
