{
  "name": "@diagrist/parts",
  "version": "0.0.0",
  "description": "Pieces several Diagrist plugins draw alike: title header, decision bar, legends, margin notes, picture words.",
  "keywords": [
    "diagrist",
    "diagrams-as-code",
    "diagram",
    "svg"
  ],
  "homepage": "https://github.com/diagrist/diagrist/tree/main/packages/parts#readme",
  "bugs": "https://github.com/diagrist/diagrist/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diagrist/diagrist.git",
    "directory": "packages/parts"
  },
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@diagrist/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22.11"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "@diagrist/core": "workspace:*",
    "@diagrist/lang": "workspace:*"
  }
}
