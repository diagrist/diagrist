{
  "name": "diagrist",
  "version": "0.0.0",
  "description": "The Diagrist command line: format, check and build .dgr files, and look up the grammar of a kind.",
  "keywords": [
    "diagrist",
    "diagrams-as-code",
    "diagram",
    "cli",
    "uml",
    "c4",
    "svg",
    "png"
  ],
  "homepage": "https://github.com/diagrist/diagrist/tree/main/packages/cli#readme",
  "bugs": "https://github.com/diagrist/diagrist/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diagrist/diagrist.git",
    "directory": "packages/cli"
  },
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "diagrist": "./dist/main.js",
    "dgr": "./dist/main.js"
  },
  "exports": {
    ".": {
      "@diagrist/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tables": {
      "@diagrist/source": "./src/tables.ts"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22.11"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "@diagrist/core": "workspace:*",
    "@diagrist/export-png": "workspace:*",
    "@diagrist/lang": "workspace:*",
    "@diagrist/plugin-architecture": "workspace:*",
    "@diagrist/plugin-code": "workspace:*",
    "@diagrist/plugin-concept": "workspace:*",
    "@diagrist/plugin-uml": "workspace:*"
  },
  "devDependencies": {
    "@diagrist/testkit": "workspace:*"
  }
}
