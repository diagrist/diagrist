{
  "name": "diagrist-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.11"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "build": "tsdown --workspace '{packages,plugins}/*'",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "format": "biome check --write .",
    "docs:generate": "UPDATE_GOLDEN=1 vitest run --project docs --project plugin-uml --project plugin-architecture derived readme notice",
    "docs:uml": "UPDATE_GOLDEN=1 vitest run --project plugin-uml readme",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm knip",
    "changeset": "changeset",
    "knip": "knip"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^22.20.5",
    "knip": "^6.42.1",
    "oxc-parser": "^0.155.0",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
